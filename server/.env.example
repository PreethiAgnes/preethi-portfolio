# MongoDB Atlas connection string (free M0 cluster) — get from Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

PORT=5000

# The deployed frontend origin, e.g. https://preethi-portfolio.vercel.app
# Use * for local development
CLIENT_ORIGIN=*

# Optional: email notification on each contact form submission, sent via Resend
# (https://resend.com — free tier, ~3000 emails/month). Uses an HTTPS API rather
# than raw SMTP, since most free-tier hosts (Render included) block outbound
# SMTP ports. Get an API key from the Resend dashboard > API Keys.
# Leave both blank to disable email notifications (messages are still saved to MongoDB).
RESEND_API_KEY=
NOTIFY_EMAIL=youraddress@gmail.com
